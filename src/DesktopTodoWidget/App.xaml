<Application x:Class="DesktopTodoWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <Application.Resources>
    <sys:String x:Key="WindowTitleText">Desktop Todo Widget</sys:String>
    <sys:String x:Key="ExitMenuItemText">Exit</sys:String>
    <sys:String x:Key="AddTaskPlaceholderText">Add a task…</sys:String>
    <sys:String x:Key="EmptyTasksText">No tasks yet.</sys:String>
    <sys:String x:Key="DeleteTaskText">Delete task</sys:String>
    <sys:String x:Key="DeleteButtonText">×</sys:String>
    <sys:String x:Key="RecoveredFromBackupText">Tasks were recovered from backup.</sys:String>
    <sys:String x:Key="ReadOnlySchemaText">This todo list was created by a newer version and is read-only.</sys:String>
  </Application.Resources>
</Application>
