<Window x:Class="DesktopTodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:DesktopTodoWidget.Data"
        Title="{DynamicResource WindowTitleText}"
        Width="360"
        Height="420"
        Left="80"
        Top="80"
        Background="#1E1E1E"
        Foreground="#F2F2F2"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="{DynamicResource ExitMenuItemText}"
                Click="ExitMenuItem_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TaskInputPanel">
      <TextBox x:Name="NewTaskTextBox"
               MinHeight="30"
               Padding="8,4"
               VerticalContentAlignment="Center"
               ToolTip="{DynamicResource AddTaskPlaceholderText}"
               KeyDown="NewTaskTextBox_KeyDown"
               TextChanged="NewTaskTextBox_TextChanged" />
      <TextBlock x:Name="NewTaskPlaceholderTextBlock"
                 Margin="9,5,24,5"
                 VerticalAlignment="Center"
                 Foreground="#8C8C8C"
                 IsHitTestVisible="False"
                 Text="{DynamicResource AddTaskPlaceholderText}" />
    </Grid>

    <TextBlock x:Name="TodoStatusTextBlock"
               Grid.Row="1"
               Margin="0,8,0,0"
               Foreground="#F0B45B"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <Grid x:Name="TaskListPanel"
          Grid.Row="2"
          Margin="0,10,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="TodoItemsControl"
                      ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type data:TodoListItemViewModel}">
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsDone, Mode=OneWay}"
                          Click="TodoItemCheckBox_Click" />

                <Grid Grid.Column="1">
                  <Button Background="Transparent"
                          BorderThickness="0"
                          HorizontalContentAlignment="Left"
                          Padding="0"
                          VerticalContentAlignment="Center"
                          MouseDoubleClick="TodoItemTextButton_MouseDoubleClick">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter Property="TextDecorations" Value="Strikethrough" />
                            <Setter Property="Opacity" Value="0.5" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                    </TextBlock>
                  </Button>

                  <TextBox Padding="4,2"
                           VerticalContentAlignment="Center"
                           Text="{Binding EditingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           KeyDown="TodoItemEditTextBox_KeyDown"
                           LostKeyboardFocus="TodoItemEditTextBox_LostKeyboardFocus">
                    <TextBox.Style>
                      <Style TargetType="{x:Type TextBox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                </Grid>

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="5,0"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource DeleteTaskText}"
                        Content="{DynamicResource DeleteButtonText}"
                        Click="DeleteTodoItemButton_Click" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="#A6A6A6"
                 IsHitTestVisible="False"
                 Text="{DynamicResource EmptyTasksText}">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasItems}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Grid>
</Window>
