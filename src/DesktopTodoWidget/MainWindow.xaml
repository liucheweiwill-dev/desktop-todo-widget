<Window x:Class="DesktopTodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitleText}"
        Width="360"
        Height="420"
        Left="80"
        Top="80"
        Background="#1E1E1E"
        Foreground="#F2F2F2"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="{DynamicResource ExitMenuItemText}"
                Click="ExitMenuItem_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid Background="#1E1E1E">
    <TextBlock HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Text="{DynamicResource PlaceholderText}"
               TextWrapping="Wrap" />
  </Grid>
</Window>
