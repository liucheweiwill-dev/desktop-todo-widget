<Window x:Class="DesktopTodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:DesktopTodoWidget.Data"
        Title="{DynamicResource WindowTitleText}"
        Width="360"
        Height="420"
        Left="80"
        Top="80"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False">
  <Window.ContextMenu>
    <ContextMenu Style="{StaticResource TodoContextMenuStyle}">
      <MenuItem Header="{DynamicResource ExitMenuItemText}"
                Style="{StaticResource TodoMenuItemStyle}"
                Click="ExitMenuItem_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="WindowDragStrip"
            Grid.Row="0"
            Background="{StaticResource InputBackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1" />

    <Grid Grid.Row="1"
          Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="TaskInputPanel"
          Grid.Row="2"
          Margin="0,8,0,0">
      <TextBox x:Name="NewTaskTextBox"
               Style="{StaticResource TodoTextBoxStyle}"
               MinHeight="30"
               Padding="8,4"
               VerticalContentAlignment="Center"
               ToolTip="{DynamicResource AddTaskPlaceholderText}"
               KeyDown="NewTaskTextBox_KeyDown"
               TextChanged="NewTaskTextBox_TextChanged" />
      <TextBlock x:Name="NewTaskPlaceholderTextBlock"
                 Margin="9,5,24,5"
                 VerticalAlignment="Center"
                 Background="{StaticResource TransparentBrush}"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 IsHitTestVisible="False"
                 Text="{DynamicResource AddTaskPlaceholderText}" />
    </Grid>

    <TextBlock x:Name="TodoStatusTextBlock"
               Style="{StaticResource TodoStatusTextBlockStyle}"
               Grid.Row="1"
               Margin="0,8,0,0"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <Grid x:Name="TaskListPanel"
          Grid.Row="0">
      <ScrollViewer x:Name="TaskListScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Foreground="{StaticResource PrimaryTextBrush}">
        <!-- WPF 沒有 VerticalScrollBarStyle 屬性；用隱式樣式套進 ScrollViewer 樣板裡的 ScrollBar -->
        <ScrollViewer.Resources>
          <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource TodoVerticalScrollBarStyle}" />
        </ScrollViewer.Resources>
        <ItemsControl x:Name="TodoItemsControl"
                      Background="{StaticResource TransparentBrush}"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type data:TodoListItemViewModel}">
              <Grid Margin="0,0,0,6"
                    PreviewMouseLeftButtonDown="TodoItemGrid_PreviewMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Style="{StaticResource TodoCheckBoxStyle}"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsDone, Mode=OneWay}"
                          Click="TodoItemCheckBox_Click" />

                <Grid Grid.Column="1">
                  <Button x:Name="TodoItemTextButton"
                          BorderThickness="0"
                          HorizontalContentAlignment="Left"
                          Padding="0"
                          VerticalContentAlignment="Center"
                          MouseDoubleClick="TodoItemTextButton_MouseDoubleClick">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}"
                             BasedOn="{StaticResource TodoTaskTextButtonStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding Text}"
                               FontSize="{Binding EffectiveFontSize}"
                               TextWrapping="Wrap"
                               Style="{StaticResource TodoItemTextBlockStyle}" />
                  </Button>

                  <TextBox Padding="4,2"
                           VerticalContentAlignment="Center"
                           Text="{Binding EditingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           KeyDown="TodoItemEditTextBox_KeyDown"
                           LostKeyboardFocus="TodoItemEditTextBox_LostKeyboardFocus">
                    <TextBox.Style>
                      <Style TargetType="{x:Type TextBox}"
                             BasedOn="{StaticResource TodoTextBoxStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                </Grid>

                <Grid Grid.Column="2"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center">
                  <Button x:Name="TodoItemStyleButton"
                          Style="{StaticResource TodoDeleteButtonStyle}"
                          Padding="5,0"
                          ToolTip="{DynamicResource TaskSettingsText}"
                          Content="{DynamicResource TaskSettingsButtonText}"
                          Tag="{Binding ElementName=TodoItemStylePopup}"
                          Click="TodoItemStyleButton_Click" />

                  <Popup x:Name="TodoItemStylePopup"
                         AllowsTransparency="False"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Placement="Bottom"
                         PlacementTarget="{Binding ElementName=TodoItemStyleButton}"
                         PopupAnimation="Fade"
                         StaysOpen="False"
                         Opened="TodoItemStylePopup_Opened"
                         PreviewMouseLeftButtonDown="TodoItemStylePopup_PreviewMouseLeftButtonDown">
                    <Border Margin="0,4,0,0"
                            Padding="8"
                            Background="{StaticResource MenuBackgroundBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <TextBlock Text="{DynamicResource TextSizeText}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                          <Button Style="{StaticResource TodoDeleteButtonStyle}"
                                  Padding="6,1"
                                  ToolTip="{DynamicResource DecreaseFontSizeText}"
                                  Content="{DynamicResource DecreaseFontSizeButtonText}"
                                  Click="DecreaseTodoItemFontSizeButton_Click" />
                          <TextBlock Width="32"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"
                                     Text="{Binding EffectiveFontSize, StringFormat={}{0:0.##}}" />
                          <Button Style="{StaticResource TodoDeleteButtonStyle}"
                                  Padding="6,1"
                                  ToolTip="{DynamicResource IncreaseFontSizeText}"
                                  Content="{DynamicResource IncreaseFontSizeButtonText}"
                                  Click="IncreaseTodoItemFontSizeButton_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                          <Button Tag="default"
                                  Background="{StaticResource TodoColorDefaultBrush}"
                                  ToolTip="{DynamicResource DefaultColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="default">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Tag="yellow"
                                  Margin="4,0,0,0"
                                  Background="{StaticResource TodoColorYellowBrush}"
                                  ToolTip="{DynamicResource YellowColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="yellow">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Tag="orange"
                                  Margin="4,0,0,0"
                                  Background="{StaticResource TodoColorOrangeBrush}"
                                  ToolTip="{DynamicResource OrangeColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="orange">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Tag="red"
                                  Margin="4,0,0,0"
                                  Background="{StaticResource TodoColorRedBrush}"
                                  ToolTip="{DynamicResource RedColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="red">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Tag="green"
                                  Margin="4,0,0,0"
                                  Background="{StaticResource TodoColorGreenBrush}"
                                  ToolTip="{DynamicResource GreenColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="green">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Tag="blue"
                                  Margin="4,0,0,0"
                                  Background="{StaticResource TodoColorBlueBrush}"
                                  ToolTip="{DynamicResource BlueColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="blue">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Tag="purple"
                                  Margin="4,0,0,0"
                                  Background="{StaticResource TodoColorPurpleBrush}"
                                  ToolTip="{DynamicResource PurpleColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="purple">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Tag="cyan"
                                  Margin="4,0,0,0"
                                  Background="{StaticResource TodoColorCyanBrush}"
                                  ToolTip="{DynamicResource CyanColorText}"
                                  Click="TodoItemColorButton_Click">
                            <Button.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TodoColorSwatchButtonStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding EffectiveColorKey}" Value="cyan">
                                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </StackPanel>

                        <Button Style="{StaticResource TodoDeleteButtonStyle}"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource ResetStyleText}"
                                Click="ResetTodoItemStyleButton_Click" />
                      </StackPanel>
                    </Border>
                  </Popup>
                </Grid>

                <Button Grid.Column="3"
                        Style="{StaticResource TodoDeleteButtonStyle}"
                        Margin="8,0,0,0"
                        Padding="5,0"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource DeleteTaskText}"
                        Content="{DynamicResource DeleteButtonText}"
                        Click="DeleteTodoItemButton_Click" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Text="{DynamicResource EmptyTasksText}">
        <TextBlock.Style>
          <Style TargetType="{x:Type TextBlock}"
                 BasedOn="{StaticResource TodoEmptyStateTextBlockStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasItems}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <Canvas IsHitTestVisible="False">
        <Border x:Name="DragInsertionIndicator"
                Height="2"
                Background="{StaticResource FocusBorderBrush}"
                Visibility="Collapsed" />
      </Canvas>
    </Grid>
  </Grid>
  </Grid>
</Window>
