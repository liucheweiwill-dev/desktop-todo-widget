<Window x:Class="DesktopTodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitleText}"
        Width="360"
        Height="420"
        Left="80"
        Top="80"
        Background="#1E1E1E"
        Foreground="#F2F2F2"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="StatusText"
               Grid.Row="0"
               TextWrapping="Wrap"
               FontSize="16" />

    <Button x:Name="VerifyButton"
            Grid.Row="2"
            Width="130"
            Height="32"
            HorizontalAlignment="Left"
            Content="{DynamicResource VerifyButtonText}"
            Click="VerifyButton_Click" />

    <TextBox x:Name="InputTextBox"
             Grid.Row="4"
             Height="32"
             VerticalContentAlignment="Center" />
  </Grid>
</Window>
